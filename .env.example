#
# LinkedIn OAuth + Posts API (server/index.mjs)
#
# 1) Create a LinkedIn app in the LinkedIn Developer Portal.
# 2) Add the redirect URL below to the app:
#    http://localhost:5174/api/linkedin/callback
# 3) Fill in the values and copy this file to `.env` (do not commit `.env`).
#

LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=

# Must exactly match what you set in the LinkedIn app.
LINKEDIN_REDIRECT_URI=http://localhost:5174/api/linkedin/callback

# Scopes depend on your LinkedIn app product/permissions.
# Start here; you may need to adjust based on what LinkedIn grants.
LINKEDIN_SCOPE=r_organization_social r_organization_admin

# LinkedIn REST API version header (YYYYMM)
LINKEDIN_VERSION=202601

# Local API server port
API_PORT=5174

